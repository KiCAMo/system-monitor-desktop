{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "System Monitor",
  "version": "0.1.1",
  "identifier": "com.kicamo.system-monitor",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "System Monitor",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true
      },
      {
        "label": "settings",
        "title": "설정",
        "url": "settings.html",
        "width": 720,
        "height": 800,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "visible": false
      },
      {
        "label": "history",
        "title": "매칭 히스토리",
        "url": "history.html",
        "width": 880,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "EC2 docker log monitor with claude/codex injection",
    "longDescription": "Detects errors in remote docker container logs over SSH and pastes the captured context into a local claude or codex CLI session. Multi-node monitoring, profile switching, browse history, and re-inject from past matches.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/KiCAMo/system-monitor-desktop/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyRTNCNjg2N0YzOEFBNDIKUldSQ3FqaC9ocmJqSXBUYkQwUmFFZmhZT3RvUGRabnYwWHN0ZzNJdDE5eTlxUnNZbUY0aUF5V24K"
    }
  }
}